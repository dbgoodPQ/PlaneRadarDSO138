+// Paint whatever part of the panel the square radar frame does not cover (the
+// side bands on a 320x240 panel). No-op on the 240x240 round display.
+void clearPanelMargins() {
+  const int left = config::kRadarOriginX;
+  const int top = config::kRadarOriginY;
+  const int right = config::kRadarOriginX + config::kRadarFrameSize;
+  const int bottom = config::kRadarOriginY + config::kRadarFrameSize;
+  const uint16_t bg = radar::kColorBackground;
+  if (left > 0) {
+    tft.fillRect(0, 0, left, config::kDisplayHeight, bg);
+  }
+  if (right < config::kDisplayWidth) {
+    tft.fillRect(right, 0, config::kDisplayWidth - right, config::kDisplayHeight, bg);
+  }
+  if (top > 0) {
+    tft.fillRect(left, 0, config::kRadarFrameSize, top, bg);
+  }
+  if (bottom < config::kDisplayHeight) {
+    tft.fillRect(left, bottom, config::kRadarFrameSize, config::kDisplayHeight - bottom, bg);
+  }
+}
